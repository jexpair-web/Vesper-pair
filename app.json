{
  "name": "JEXPLOIT Session Generator",
  "description": "A session ID generator for JEXPLOIT WhatsApp Bot",
  "logo": "https://files.catbox.moe/ojo6av.jpg",
  "repository": "https://github.com/Kevintech-hub/Jexploit-Bot",
  "keywords": ["whatsapp", "bot", "session", "generator"],
  "stack": "heroku-24",
  "success_url": "/",
  "scripts": {
    "start": "node index.js"
  },
  "env": {
    "PORT": {
      "description": "Port for web app. 3000, 5000, 8000... any!",
      "value": "3000",
      "required": false
    },
    "NODE_ENV": {
      "description": "Node environment",
      "value": "production",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "addons": [
    {
      "plan": "heroku-postgresql"
    }
  ]
}